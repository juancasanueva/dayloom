    },
    "Line %lld: %@ needs ⌘ or ⌃ so it doesn't take over typing; keeping %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld: %@ benötigt ⌘ oder ⌃, damit der Kurzbefehl die Texteingabe nicht blockiert; %@ wird beibehalten."

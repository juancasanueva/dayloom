          "stringUnit" : {
            "state" : "translated",
            "value" : "Riga %lld: %@ funziona in tutte le app, quindi richiede cmd, ctrl o option; viene mantenuta %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld行目：%@はすべてのAppで機能するため、cmd、ctrl、またはoptionが必要です。%@のままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번째 줄: %@은(는) 모든 앱에서 작동하므로 cmd, ctrl 또는 option이 필요합니다. %@ 키를 유지합니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linha %lld: %@ funciona em todas as aplicações, por isso precisa de cmd, ctrl ou option; mantém-se %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %lld 行：%@ 在所有 App 中都可用，因此需要包含 cmd、ctrl 或 option；将保留 %@。"
          }
        }
      }
    },

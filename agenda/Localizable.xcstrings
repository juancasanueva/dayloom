    "%@ (%@)" : {},
    "%@ both use %@; only one of them will work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwenden beide %@; nur eine davon funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usan ambos %@; solo funcionará uno de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilisent tous deux %@ ; une seule de ces actions fonctionnera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usano entrambe %@; solo una delle due funzionerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はどちらも%@を使用しています。どちらか一方しか機能しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모두 %@ 키를 사용합니다. 둘 중 하나만 작동합니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usam ambos %@; só um deles funcionará."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 都使用了 %@；只有其中一个会生效。"
          }
        }
      }
    },
    "%@ couldn't be set up as the system-wide shortcut, probably because another app already uses it. Choose other keys for quick_launcher_anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht als systemweiter Kurzbefehl eingerichtet werden, vermutlich weil eine andere App ihn bereits verwendet. Wähle andere Tasten für quick_launcher_anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido configurar %@ como atajo de todo el sistema, probablemente porque otra app ya lo usa. Elige otras teclas para quick_launcher_anywhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de définir %@ comme raccourci global, sans doute parce qu’une autre app l’utilise déjà. Choisissez d’autres touches pour quick_launcher_anywhere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile impostare %@ come abbreviazione di sistema, probabilmente perché un’altra app la usa già. Scegli altri tasti per quick_launcher_anywhere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をシステム全体のショートカットとして設定できませんでした。ほかのAppがすでに使用している可能性があります。quick_launcher_anywhereには別のキーを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키를 시스템 전체 단축키로 설정할 수 없습니다. 다른 앱에서 이미 사용 중일 수 있습니다. quick_launcher_anywhere에 다른 키를 선택하세요."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível configurar %@ como atalho de todo o sistema, provavelmente porque outra aplicação já o utiliza. Escolha outras teclas para quick_launcher_anywhere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将 %@ 设为系统范围的快捷键，可能是因为其他 App 已在使用它。请为 quick_launcher_anywhere 选择其他按键。"
          }
        }
      }
    },

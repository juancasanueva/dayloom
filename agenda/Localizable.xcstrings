            "value" : "%lld번째 줄: %@은(는) 이미 %lld번째 줄에 설정되어 있습니다. 이 줄이 우선 적용됩니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

    "Its %lld subtasks will be deleted too. You can't undo this." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch ihre %lld Unteraufgabe wird gelöscht. Dieser Vorgang kann nicht widerrufen werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Auch ihre %lld Unteraufgaben werden gelöscht. Dieser Vorgang kann nicht widerrufen werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld subtask will be deleted too. You can't undo this."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Its %lld subtasks will be deleted too. You can't undo this."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se eliminará su %lld subtarea. Esta acción no se puede deshacer."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "También se eliminarán sus %lld subtareas. Esta acción no se puede deshacer."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sa %lld sous-tâche sera également supprimée. Vous ne pouvez pas annuler cette action."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ses %lld sous-tâches seront également supprimées. Vous ne pouvez pas annuler cette action."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Verrà eliminata anche la sua %lld sottoattività. Non puoi annullare questa azione."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Verranno eliminate anche le sue %lld sottoattività. Non puoi annullare questa azione."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件のサブタスクも削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하위 작업 %lld개도 함께 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-PT" : {
          "variations" : {
            "plural" : {

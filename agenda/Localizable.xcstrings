            "value" : "%lld번째 줄: %@은(는) Dayloom이 알 수 없는 섹션입니다. 그 이후의 줄은 계속 단축키로 읽힙니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",

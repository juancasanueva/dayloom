          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez keys.toml et enregistrez-le ; Dayloom applique les changements immédiatement. Supprimez une ligne pour revenir à sa valeur par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica keys.toml e salvalo; Dayloom applica subito le modifiche. Elimina una riga per tornare al valore predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {

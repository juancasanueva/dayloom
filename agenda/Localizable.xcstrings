          }
        }
      }
    },
    "Line %lld: \"%@\" for %@ isn't a shortcut Dayloom understands; keeping %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld: \"%@\" für %@ ist kein Kurzbefehl, den Dayloom versteht; %@ wird beibehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Línea %lld: \"%@\" para %@ no es un atajo que Dayloom entienda; se mantiene %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligne %lld : « %@ » pour %@ n’est pas un raccourci compris par Dayloom ; %@ est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riga %lld: “%@” per %@ non è un’abbreviazione riconosciuta da Dayloom; viene mantenuta %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld行目：%3$@の\"%2$@\"はDayloomが認識できるショートカットではありません。%4$@のままにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld번째 줄: %3$@에 지정된 \"%2$@\"은(는) Dayloom이 인식할 수 있는 단축키가 아닙니다. %4$@ 키를 유지합니다."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linha %lld: \"%@\" para %@ não é um atalho que o Dayloom entenda; mantém-se %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %1$lld 行：%3$@ 的“%2$@”不是 Dayloom 能识别的快捷键；将保留 %4$@。"
          }
        }
      }
    },
    "Line %lld: %@ is already set on line %lld; this line wins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld: %@ ist bereits in Zeile %lld festgelegt; diese Zeile hat Vorrang."

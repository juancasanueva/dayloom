    "Your changes are kept on this Mac, and Dayloom keeps retrying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen bleiben auf diesem Mac erhalten und Dayloom versucht es weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios se guardan en este Mac y Dayloom seguirá intentándolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications sont conservées sur ce Mac, et Dayloom continue de réessayer."

    "Line %lld: %@ isn't a section Dayloom knows; the lines after it are still read as shortcuts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %lld: %@ ist kein Abschnitt, den Dayloom kennt; die folgenden Zeilen werden trotzdem als Kurzbefehle gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

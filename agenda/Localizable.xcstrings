    "In Teams, choose Meet, then Create a meeting link. Copy it and paste it above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in Teams „Meet“ und erstelle dann einen Meeting-Link. Kopiere ihn und füge ihn oben ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Teams, elige Reunirse y luego Crear un vínculo de reunión. Cópialo y pégalo arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Teams, choisissez Réunion, puis Créer un lien de réunion. Copiez-le et collez-le ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Teams, scegli Riunione, poi Crea un link alla riunione. Copialo e incollalo qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teamsで「Meet」を選択し、ミーティングリンクを作成します。そのリンクをコピーして上にペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teams에서 Meet을 선택한 다음 회의 링크 만들기를 선택하세요. 링크를 복사하여 위에 붙여넣으세요."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Teams, escolha Reunir e depois Criar uma ligação de reunião. Copie-a e cole-a acima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Teams 中，选择“Meet”，然后选择“创建会议链接”。拷贝链接并粘贴到上方。"
          }
        }
      }
    },
